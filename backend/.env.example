# 站点接口配置。复制为 backend/.env 后再改。不要把 .env 提交到仓库。

# MySQL 连接。库需要提前建好，字符集用 utf8mb4。
DATABASE_URL=mysql+pymysql://nav:navpass@127.0.0.1:3306/navhub?charset=utf8mb4

# 会话、登录锁定和注册滑块都放在 Redis。
REDIS_URL=redis://127.0.0.1:6379/0

# 会话签名密钥。公开部署前必须换成一长串随机字符。
SECRET_KEY=change-this-secret

# 后台入口，32 位随机码。访问地址是 http://站点/<ADMIN_GATE>
# 留空时第一次启动会生成并写回这个文件。改掉并重启后，只有新地址有效，旧地址返回 404 并回到首页。
ADMIN_GATE=

# 第一次启动时创建的管理员。公开部署前必须改掉。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# 浏览器允许带登录 Cookie 访问接口的前端地址，多个用逗号隔开。
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 代理池地址。留空则抓取不走代理。本地代理池默认是 http://127.0.0.1:8010
PROXY_POOL_URL=

# 注册用户每月可提交的链接数。VIP 由管理员在后台开通。
FREE_MONTHLY_QUOTA=5
VIP_MONTHLY_QUOTA=100
